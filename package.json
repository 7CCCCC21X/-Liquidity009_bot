{
  "name": "liquidity009-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot — paste a Predict.fun URL, pick a market card, watch the orderbook change in real time.",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:local": "node --env-file=.env src/index.js",
    "get-chat-id": "node --env-file=.env scripts/get-chat-id.js",
    "diagnose": "node --env-file=.env scripts/diagnose.js",
    "diagnose-question": "node --env-file=.env scripts/diagnose-question.js",
    "prune-history": "node --env-file=.env scripts/prune-history.js",
    "backfill-question": "node --env-file=.env scripts/backfill-question.js",
    "reset-thresholds": "node --env-file=.env scripts/reset-thresholds.js",
    "check": "node --check src/*.js scripts/*.js"
  }
}
