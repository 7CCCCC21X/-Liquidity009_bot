# --- Telegram ---
# 1) Create the bot via @BotFather, copy the token below.
# 2) Send the bot /start in a private chat (or add to a group).
# 3) Run `npm run get-chat-id` to discover your chat id.
TELEGRAM_BOT_TOKEN=
# Admin chat id — receives diagnostics; can always issue commands.
TELEGRAM_CHAT_ID=

# --- Predict.fun API ---
PREDICT_API_KEY=
GRAPHQL_URL=https://graphql.predict.fun/graphql
REST_URL=https://api.predict.fun/v1

# REST orderbook URL shape. {key} is replaced with conditionId by default.
ORDERBOOK_PATH_TEMPLATE=/markets/{key}/orderbook
ORDERBOOK_KEY_FIELD=conditionId

# --- Polling ---
# How often to refresh each watched orderbook (ms). Default 30s; can
# go as low as POLL_MIN_INTERVAL_MS for sub-second polling.
POLL_INTERVAL_MS=30000
# Hard floor for the monitor sleep — protects against runaway loops if
# POLL_INTERVAL_MS is set very low. Default 200ms supports sub-second
# polling on healthy networks; bump to 1000+ if you see Predict.fun
# 429s under sustained load.
POLL_MIN_INTERVAL_MS=200
# Max parallel orderbook fetches per tick. Higher = faster cycle for
# users with many subscriptions; lower if you want to be gentler on
# the API. Default 8.
POLL_CONCURRENCY=8
# How long to cache the GraphQL market list (ms). Default 10 min.
MARKETS_CACHE_TTL_MS=600000

# --- Change-detection thresholds ---
# Notify when best-bid OR best-ask price moves by ≥ this (probability points).
PRICE_EPSILON=0.005
# Notify when best-bid OR best-ask size changes by ≥ this fraction (0.10 = 10%).
SIZE_RELATIVE_EPSILON=0.10
# …or by at least this absolute number of shares.
SIZE_ABSOLUTE_MIN=50
# Minimum seconds between consecutive change notifications per market+chat.
NOTIFY_COOLDOWN_SEC=60

# --- State persistence ---
# On Railway, attach a Volume (mount path /data) and point both files at
# /data so subscriptions + history survive redeploys.
STATE_FILE=./state.json

# --- History (变动记录持久化) ---
# Each push notification appends one JSON line to HISTORY_FILE. Used by
# /history <id> [N] and /export commands.
HISTORY_ENABLED=true
HISTORY_FILE=./history.jsonl
# Auto-prune entries older than this many days, at most once per 24h.
# 0 disables auto-prune (use `npm run prune-history` manually).
HISTORY_KEEP_DAYS=14
