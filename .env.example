# --- Telegram ---
# 1) Create the bot via @BotFather, copy the token below.
# 2) Send the bot /start in a private chat (or add to a group).
# 3) Run `npm run get-chat-id` to discover your chat id.
TELEGRAM_BOT_TOKEN=
# Admin chat id — receives diagnostics; can always issue commands.
TELEGRAM_CHAT_ID=
# Comma-separated whitelist of chat IDs allowed to use the bot. Leave
# empty to keep open access (any chat can subscribe). Set to e.g.
# "12345,67890" to restrict — every other chat is told it isn't
# authorised at the message/callback entry point.
ALLOWED_CHAT_IDS=

# --- Predict.fun API ---
# 建议给这个机器人单独建一个 Predict.fun「应用」并用它自己的 key：速率限制
# 是按应用计的（基础等级 通用 5,000 次/分钟），和交易程序共用一个 key 会互相
# 挤占配额。
PREDICT_API_KEY=
GRAPHQL_URL=https://graphql.predict.fun/graphql
REST_URL=https://api.predict.fun/v1

# 客户端 REST 限速（次/分钟，令牌桶）。默认 3000，给同一 key 上的其他程序留
# 余量；改成和你的应用等级一致再减去别的程序用量。0 = 不限速。
REST_RATE_LIMIT_PER_MIN=3000
# 桶的突发上限（默认约 2 秒的配额）。
REST_RATE_LIMIT_BURST=0
# 订单簿 404（市场已结算/下架）后的指数退避上限（ms）。命中 404 的市场按
# 1s→2s→4s… 递增间隔重试，不再每个 tick 都打；连续 404 超过 1 分钟自动退订。
ORDERBOOK_404_BACKOFF_MAX_MS=60000

# --- WebSocket 实时订单簿（wss://ws.predict.fun/ws） ---
# 开启后每个订阅的市场都走 WS 推送：挂撤单日记按推送即时记录，30 秒主循环
# 直接复用推送到的订单簿，几乎不消耗 REST 配额。任何时候 WS 断线 / 某市场
# 订阅被拒 / 推送停了，该市场自动回到 REST 轮询，不会比纯轮询更差。
# 需要 Node ≥ 22（内置 WebSocket）；老版本会打一条日志然后只用轮询。
PREDICT_WS_ENABLED=true
PREDICT_WS_URL=wss://ws.predict.fun/ws
# 心跳看门狗：这么久收不到任何消息就判定连接死了，重连 + 回退轮询。
PREDICT_WS_STALE_MS=45000
# WS 在线的市场仍按这个间隔用 REST 做一次「审计」，发现推送漏了变动就把该
# 市场切回全速轮询 PREDICT_WS_DISTRUST_MS。0 = 不审计。
PREDICT_WS_AUDIT_INTERVAL_MS=60000
PREDICT_WS_DISTRUST_MS=600000

# Referral code attached to predict.fun market URLs the bot prints
# (clicking a market title in Telegram opens the page with this ref).
# Default 'B00EA'; set blank to disable the suffix.
PREDICT_REF_CODE=B00EA
# URL locale prefix — predict.fun mirrors the same page at /, /zh-cn/,
# /en/. Default 'zh-cn'.
PREDICT_URL_LOCALE=zh-cn

# 显示时区。任何 IANA 名（'Asia/Shanghai' / 'America/New_York' / 'UTC'…）。
# 标签会附在时间后面让用户知道时区。默认 北京时间 (UTC+8)。
DISPLAY_TZ=Asia/Shanghai
DISPLAY_TZ_LABEL=北京时间

# REST orderbook URL shape. {key} is replaced with conditionId by default.
ORDERBOOK_PATH_TEMPLATE=/markets/{key}/orderbook
ORDERBOOK_KEY_FIELD=conditionId

# --- Polling ---
# How often to refresh each watched orderbook (ms). Default 30s; can
# go as low as POLL_MIN_INTERVAL_MS for sub-second polling.
POLL_INTERVAL_MS=30000
# Hard floor for the monitor sleep — protects against runaway loops if
# POLL_INTERVAL_MS is set very low. Default 200ms supports sub-second
# polling on healthy networks; bump to 1000+ if you see Predict.fun
# 429s under sustained load.
POLL_MIN_INTERVAL_MS=200
# Max parallel orderbook fetches per tick. Higher = faster cycle for
# users with many subscriptions; lower if you want to be gentler on
# the API. Default 8. (REST_RATE_LIMIT_PER_MIN is the real ceiling —
# concurrency only shapes bursts.)
POLL_CONCURRENCY=8
# How long to cache the GraphQL market list (ms). Default 10 min.
MARKETS_CACHE_TTL_MS=600000

# --- Change-detection thresholds ---
# Notify when best-bid OR best-ask price moves by ≥ this (probability points).
# 0.001 = 0.1¢, the smallest visible tick on Predict.fun (e.g. 44.0¢ → 44.1¢).
PRICE_EPSILON=0.001
# Notify when best-bid OR best-ask size changes by ≥ this fraction (0.05 = 5%).
SIZE_RELATIVE_EPSILON=0.05
# …or by at least this absolute number of shares.
SIZE_ABSOLUTE_MIN=10
# Minimum seconds between consecutive change notifications per market+chat.
NOTIFY_COOLDOWN_SEC=60

# --- 新订阅的默认设置（已存在的订阅不变；改完仅影响以后新加的） ---
# 哪几档默认监控。逗号分隔，从 bid1,bid2,bid3,ask1,ask2,ask3 里选。
# 默认 'bid1,ask1' = 只看买1/卖1（顶档）。
DEFAULT_LEVELS=bid1,ask1
# 默认触发模式：both（价+量）/ price（只看价）/ size（只看量）。
# 默认 'price' — 份额变动不主动推送，避免大盘小波动刷屏。
DEFAULT_TRIGGER_MODE=price

# --- State persistence ---
# On Railway, attach a Volume (mount path /data) and point both files at
# /data so subscriptions + history survive redeploys.
STATE_FILE=./state.json

# --- History (变动记录持久化) ---
# Each push notification appends one JSON line to HISTORY_FILE. Used by
# /history <id> [N] and /export commands.
HISTORY_ENABLED=true
HISTORY_FILE=./history.jsonl
# Auto-prune entries older than this many days, at most once per 24h.
# 0 disables auto-prune (use `npm run prune-history` manually).
HISTORY_KEEP_DAYS=14
